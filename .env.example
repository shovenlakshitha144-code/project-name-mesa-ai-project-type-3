# MESA AI v2.0 Server Configuration
PORT=4000
NODE_ENV=development

# Session signing secret (auto-generated in data/.secret if omitted)
MESA_SESSION_SECRET=

# Encryption key for stored API keys in local vault (auto-generated if omitted)
MESA_VAULT_KEY=

# Optional pre-configured AI providers (never exposed to frontend)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default AI provider: gemini | openai | groq | openrouter | ollama | custom
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# Optional SQLite database path
MESA_DB_PATH=./data/mesa.sqlite
